{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flood-source-category-assignment.schema.json",
  "description": "PROVISIONAL Source Category Assignment Record. Category is a classification attribute without ranking; unclassified sources must not be published. Not a formal schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "assignment_id",
    "version",
    "entries",
    "approval_ref"
  ],
  "properties": {
    "schema": {
      "const": "hererisk-flood-source-category-assignment-v0.1"
    },
    "assignment_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "source_category",
          "source_organization",
          "evidence"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^fl-src-[0-9a-z]{10}$"
          },
          "source_category": {
            "type": "string",
            "enum": [
              "local_government",
              "national_government",
              "other",
              "unclassified"
            ]
          },
          "source_organization": {
            "type": "string",
            "minLength": 1
          },
          "unclassified_reason": {
            "type": "string",
            "minLength": 1
          },
          "evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "manager_codes",
              "manager_names",
              "metadata_ref",
              "listing_ref",
              "checked_on"
            ],
            "properties": {
              "manager_codes": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^[0-9]{2}$"
                }
              },
              "manager_names": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "metadata_ref": {
                "type": "string",
                "minLength": 1
              },
              "listing_ref": {
                "type": "string",
                "minLength": 1
              },
              "checked_on": {
                "type": "string",
                "format": "date"
              }
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "source_category": {
                  "const": "unclassified"
                }
              }
            },
            "then": {
              "required": [
                "unclassified_reason"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "unclassified_reason"
                ]
              }
            }
          }
        ]
      }
    },
    "approval_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    }
  }
}
