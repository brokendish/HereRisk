{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flood-source-identity-ledger.schema.json",
  "description": "PROVISIONAL Source Identity Ledger: assignment, retirement and succession of source_id. source_id is never reused. Not a formal schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "version",
    "previous_version_sha256",
    "entries"
  ],
  "properties": {
    "schema": {
      "const": "hererisk-flood-source-identity-ledger-v0.1"
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "previous_version_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_id",
          "status",
          "series_key",
          "assigned_at",
          "retired_at",
          "successors",
          "approval_ref"
        ],
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^fl-src-[0-9a-z]{10}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "active",
              "retired"
            ]
          },
          "series_key": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "dataset",
              "publisher_code",
              "scenario",
              "distribution_series"
            ],
            "properties": {
              "dataset": {
                "type": "string",
                "enum": [
                  "ksj-a31a"
                ]
              },
              "publisher_code": {
                "type": "string",
                "pattern": "^[0-9]{2}$"
              },
              "scenario": {
                "type": "string",
                "enum": [
                  "maximum"
                ]
              },
              "distribution_series": {
                "type": "string",
                "pattern": "^[0-9]{2}$"
              }
            }
          },
          "assigned_at": {
            "type": "string",
            "format": "date-time"
          },
          "retired_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "successors": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^fl-src-[0-9a-z]{10}$"
            }
          },
          "approval_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "const": "active"
                }
              }
            },
            "then": {
              "properties": {
                "retired_at": {
                  "type": "null"
                },
                "successors": {
                  "maxItems": 0
                }
              }
            },
            "else": {
              "properties": {
                "retired_at": {
                  "type": "string"
                }
              }
            }
          }
        ]
      }
    }
  }
}
