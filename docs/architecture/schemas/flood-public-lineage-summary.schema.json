{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flood-public-lineage-summary.schema.json",
  "description": "PROVISIONAL Public Lineage Summary referenced by lineage_ref (= SHA-256 of its normalized form). Public document; must not contain product_id, record_key, ZIP or member names, paths or run_id. Not a formal schema.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "source_id",
    "source_revision",
    "dataset_title",
    "publisher",
    "data_version",
    "processing",
    "products"
  ],
  "properties": {
    "schema": {
      "const": "hererisk-flood-public-lineage-summary-v0.1"
    },
    "source_id": {
      "type": "string",
      "pattern": "^fl-src-[0-9a-z]{10}$"
    },
    "source_revision": {
      "type": "integer",
      "minimum": 1
    },
    "dataset_title": {
      "type": "string",
      "minLength": 1
    },
    "publisher": {
      "type": "string",
      "minLength": 1
    },
    "data_version": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "reference_year",
        "data_reference_date"
      ],
      "properties": {
        "reference_year": {
          "type": "string",
          "pattern": "^[0-9]{4}$"
        },
        "data_reference_date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        }
      }
    },
    "processing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "normalize",
        "integration"
      ],
      "properties": {
        "normalize": {
          "$ref": "#/$defs/proc"
        },
        "integration": {
          "$ref": "#/$defs/proc"
        }
      }
    },
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "product_ref",
          "river_code",
          "river_name_in_source",
          "manager_code",
          "manager_name",
          "scenario",
          "source_zip_sha256",
          "acquired_on"
        ],
        "properties": {
          "product_ref": {
            "type": "string",
            "pattern": "^fl-prd-[0-9a-f]{16}$"
          },
          "river_code": {
            "type": "string",
            "pattern": "^[0-9]{10}$"
          },
          "river_name_in_source": {
            "type": "string",
            "minLength": 1
          },
          "manager_code": {
            "type": "string",
            "pattern": "^[0-9]{2}$"
          },
          "manager_name": {
            "type": "string",
            "minLength": 1
          },
          "scenario": {
            "type": "string",
            "enum": [
              "maximum"
            ]
          },
          "source_zip_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "acquired_on": {
            "type": "string",
            "format": "date"
          }
        }
      }
    }
  },
  "$defs": {
    "proc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "processing_id",
        "version"
      ],
      "properties": {
        "processing_id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
