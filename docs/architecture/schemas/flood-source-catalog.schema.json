{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "flood-source-catalog.schema.json",
  "description": "PROVISIONAL Source Catalog (internal document). Fields marked x-hererisk-visibility=internal must not appear in public API projections. Not a formal schema (Flood Source Catalog / Identity Contract v0.1, draft).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "catalog_id",
    "version",
    "based_on",
    "sources"
  ],
  "properties": {
    "schema": {
      "const": "hererisk-flood-source-catalog-v0.1"
    },
    "catalog_id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "based_on": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "integration_manifest_content_sha256",
        "integrated_db_logical_sha256",
        "category_assignment",
        "identity_ledger"
      ],
      "properties": {
        "integration_manifest_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "integrated_db_logical_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "category_assignment": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "version",
            "content_sha256"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "identity_ledger": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "content_sha256"
          ],
          "properties": {
            "version": {
              "type": "string",
              "minLength": 1
            },
            "content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/source"
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_revision",
        "series_key",
        "source_category",
        "source_organization",
        "title",
        "rivers",
        "scenario",
        "data_version",
        "attribution",
        "lineage_ref",
        "service_region",
        "assessed_extent",
        "depth_class_scheme",
        "products",
        "membership_digest"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "pattern": "^fl-src-[0-9a-z]{10}$",
          "x-hererisk-visibility": "public"
        },
        "source_revision": {
          "type": "integer",
          "minimum": 1,
          "x-hererisk-visibility": "public"
        },
        "series_key": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "dataset",
            "publisher_code",
            "scenario",
            "distribution_series"
          ],
          "properties": {
            "dataset": {
              "type": "string",
              "enum": [
                "ksj-a31a"
              ]
            },
            "publisher_code": {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            },
            "scenario": {
              "type": "string",
              "enum": [
                "maximum"
              ]
            },
            "distribution_series": {
              "type": "string",
              "pattern": "^[0-9]{2}$"
            }
          },
          "x-hererisk-visibility": "internal"
        },
        "source_category": {
          "type": "string",
          "enum": [
            "local_government",
            "national_government",
            "other"
          ],
          "x-hererisk-visibility": "public"
        },
        "source_organization": {
          "type": "string",
          "minLength": 1,
          "x-hererisk-visibility": "public"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "x-hererisk-visibility": "public"
        },
        "rivers": {
          "type": "array",
          "minItems": 1,
          "x-hererisk-visibility": "public",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "river_code",
              "river_name_in_source",
              "product_refs"
            ],
            "properties": {
              "river_code": {
                "type": "string",
                "pattern": "^[0-9]{10}$"
              },
              "river_name_in_source": {
                "type": "string",
                "minLength": 1
              },
              "product_refs": {
                "type": "array",
                "minItems": 1,
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "pattern": "^fl-prd-[0-9a-f]{16}$"
                }
              }
            }
          }
        },
        "scenario": {
          "type": "string",
          "enum": [
            "maximum"
          ],
          "x-hererisk-visibility": "public"
        },
        "data_version": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "reference_year",
            "data_reference_date"
          ],
          "x-hererisk-visibility": "public",
          "properties": {
            "reference_year": {
              "type": "string",
              "pattern": "^[0-9]{4}$"
            },
            "data_reference_date": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            }
          }
        },
        "attribution": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "text",
            "license",
            "url"
          ],
          "x-hererisk-visibility": "public",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            },
            "license": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "url": {
              "type": [
                "string",
                "null"
              ],
              "pattern": "^https://"
            }
          }
        },
        "lineage_ref": {
          "type": "string",
          "pattern": "^fl-lin-[0-9a-f]{64}$",
          "x-hererisk-visibility": "public"
        },
        "service_region": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "region_rule_content_sha256"
          ],
          "x-hererisk-visibility": "public",
          "properties": {
            "region_rule_content_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        },
        "assessed_extent": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "kind"
          ],
          "x-hererisk-visibility": "public",
          "properties": {
            "kind": {
              "type": "string",
              "enum": [
                "unknown"
              ]
            }
          }
        },
        "depth_class_scheme": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scheme_id",
            "scheme_version",
            "classes"
          ],
          "x-hererisk-visibility": "public",
          "properties": {
            "scheme_id": {
              "type": "string",
              "minLength": 1
            },
            "scheme_version": {
              "type": "string",
              "minLength": 1
            },
            "classes": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "class_code",
                  "label",
                  "lower_m",
                  "upper_m",
                  "bounds_inclusion"
                ],
                "properties": {
                  "class_code": {
                    "type": "string",
                    "minLength": 1
                  },
                  "label": {
                    "type": "string",
                    "minLength": 1
                  },
                  "lower_m": {
                    "type": "number",
                    "minimum": 0
                  },
                  "upper_m": {
                    "type": [
                      "number",
                      "null"
                    ]
                  },
                  "bounds_inclusion": {
                    "type": "string",
                    "enum": [
                      "unspecified"
                    ]
                  }
                }
              }
            }
          }
        },
        "products": {
          "type": "array",
          "minItems": 1,
          "x-hererisk-visibility": "internal",
          "items": {
            "$ref": "#/$defs/product"
          }
        },
        "membership_digest": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "feature_count",
            "feature_key_set_sha256"
          ],
          "x-hererisk-visibility": "internal",
          "properties": {
            "feature_count": {
              "type": "integer",
              "minimum": 0
            },
            "feature_key_set_sha256": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          }
        }
      }
    },
    "product": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "product_ref",
        "zip_sha256",
        "product_id",
        "scenario_folder",
        "normalize_content_sha256",
        "manager_code",
        "manager_name",
        "river_code",
        "river_name_in_source"
      ],
      "properties": {
        "product_ref": {
          "type": "string",
          "pattern": "^fl-prd-[0-9a-f]{16}$"
        },
        "zip_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "product_id": {
          "type": "string",
          "minLength": 1
        },
        "scenario_folder": {
          "type": "string",
          "minLength": 1
        },
        "normalize_content_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "manager_code": {
          "type": "string",
          "pattern": "^[0-9]{2}$"
        },
        "manager_name": {
          "type": "string",
          "minLength": 1
        },
        "river_code": {
          "type": "string",
          "pattern": "^[0-9]{10}$"
        },
        "river_name_in_source": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
