{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "approval_id",
    "execution_context",
    "api_id",
    "source_ref",
    "operations",
    "region_codes",
    "tiles",
    "definition",
    "valid_from",
    "expires_at",
    "approved_by",
    "approval_basis_ref",
    "record_sha256"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operations": {
            "contains": {
              "const": "download"
            }
          }
        }
      },
      "then": {
        "required": [
          "acquisition"
        ]
      },
      "else": {
        "not": {
          "required": [
            "acquisition"
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operations": {
            "contains": {
              "const": "publish"
            }
          }
        }
      },
      "then": {
        "required": [
          "publication"
        ]
      },
      "else": {
        "not": {
          "required": [
            "publication"
          ]
        }
      }
    }
  ],
  "properties": {
    "schema": {
      "const": "hererisk-production-approval-v0.1"
    },
    "approval_id": {
      "type": "string",
      "pattern": "^apr-[a-z0-9][a-z0-9-]{2,62}$"
    },
    "execution_context": {
      "const": "production"
    },
    "api_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "source_ref": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "not": {
        "pattern": "^fixture-"
      }
    },
    "operations": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "download",
          "normalize",
          "validate",
          "publish"
        ]
      }
    },
    "region_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(0[1-9]|[1-3][0-9]|4[0-7])$"
      }
    },
    "tiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "z",
          "x",
          "y"
        ],
        "properties": {
          "z": {
            "type": "integer",
            "minimum": 0,
            "maximum": 30
          },
          "x": {
            "type": "integer",
            "minimum": 0
          },
          "y": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "definition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "revision",
        "raw_sha256"
      ],
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "raw_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "valid_from": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "expires_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
    },
    "approved_by": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "approval_basis_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "acquisition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "allowed_host",
        "max_tiles_per_run",
        "max_tile_bytes",
        "max_pending_acquisitions"
      ],
      "properties": {
        "allowed_host": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.[a-z]{2,}$"
        },
        "max_tiles_per_run": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1024
        },
        "max_tile_bytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1048576
        },
        "max_pending_acquisitions": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64
        }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "license",
        "attribution_url",
        "attribution_text",
        "eligibility_status",
        "eligibility_ref"
      ],
      "properties": {
        "license": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "attribution_url": {
          "type": "string",
          "pattern": "^https://[^\\s?#@]+$"
        },
        "attribution_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "eligibility_status": {
          "const": "approved"
        },
        "eligibility_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "record_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
