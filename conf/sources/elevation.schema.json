  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "name",
        "official_page_url",
        "documentation_checked_on",
        "acquisition",
        "vertical_reference",
        "usage",
        "pipeline",
        "approval_ref"
      ],
      "properties": {
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name"
          ],
          "properties": {
            "id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]*$"
            },
            "name": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "official_page_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "documentation_checked_on": {
          "type": "string",
          "format": "date"
        },
        "acquisition": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "method",
            "url_template",
            "zoom",
            "tiles"
          ],
          "properties": {
            "method": {
              "const": "xyz_png"
            },
            "url_template": {
              "type": "string",
              "pattern": "^https://[^\\s?#]+/\\{z\\}/\\{x\\}/\\{y\\}\\.png$"
            },
            "zoom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 30
            },
            "tiles": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "minItems": 1,
                  "uniqueItems": true,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "x",
                      "y"
                    ],
                    "properties": {
                      "x": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "y": {
                        "type": "integer",
                        "minimum": 0
                      }
                    }
                  }
                }
              ]
            }
          }
        },
        "vertical_reference": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "usage": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "terms_url",
            "attribution_text",
            "review_ref"
          ],
          "properties": {
            "terms_url": {
              "type": "string",
              "format": "uri",
              "pattern": "^https://"
            },
            "attribution_text": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            },
            "review_ref": {
              "type": [
                "string",
                "null"
              ],
              "minLength": 1
            }
          }
        },
        "pipeline": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "version"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "version": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          ]
        },
        "approval_ref": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "approval_ref": {
                "type": "string"
              }
            }
          },
          "then": {
            "properties": {
              "vertical_reference": {
                "type": "string",
                "minLength": 1
              },
              "pipeline": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "id",
                  "version"
                ],
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "version": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "usage": {
                "properties": {
                  "attribution_text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "review_ref": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "acquisition": {
                "properties": {
                  "tiles": {
                    "type": "array",
                    "minItems": 1
                  }
                }
              }
            }
          }
        }
      ]
    },
    "region": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "targeted",
        "source_refs"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "targeted": {
          "type": "boolean"
        },
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "targeted": {
                "const": true
              }
            }
          },
          "then": {
            "properties": {
              "source_refs": {
                "minItems": 1
              }
            }
          },
          "else": {
            "properties": {
              "source_refs": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
